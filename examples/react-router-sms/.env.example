# Copy to .env — loaded automatically by `npm run dev` (dotenv in vite.config.ts).
#
# With no .env (or SMS_TRANSPORT unset/console), sign-in codes are printed
# to the server console instead of texted — zero setup.

#SMS_TRANSPORT=console

# --- Twilio (SMS, or RCS with automatic SMS fallback) ---
#
# Run the interactive setup script to provision a number and write these:
#
#   ./scripts/setup-twilio.mts   (needs Node ≥ 22.18 — see .nvmrc at repo root)
#
# Provide TWILIO_MESSAGING_SERVICE_SID (preferred; required for RCS) or
# TWILIO_FROM (a Twilio number in E.164).
#
# Text never arrives? Check the delivery log (carriers can filter messages
# the API accepted, e.g. 30034 = unregistered A2P 10DLC number):
#   https://console.twilio.com/us1/monitor/logs/sms
#
#SMS_TRANSPORT=twilio
#TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_AUTH_TOKEN=your-auth-token
#TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_FROM=+15005550006

# Session signing secret. A hardcoded dev-only default is used when unset.
#JWT_SECRET=
