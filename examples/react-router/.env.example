# Copy to .env — loaded automatically by `npm run dev` (dotenv in vite.config.ts).
#
# With no .env (or everything below unset), the example runs in dev mode:
# sign-in emails and SMS codes are printed to the server console instead of
# being sent.

# --- Email (magic link + code) ---
#
# Setting SMTP_HOST switches to sending real email.
# Ready-made configs — copy one instead of this file:
#
#   cp .env.example.mailpit .env   # see emails in a local Mailpit web inbox
#   cp .env.example.smtp .env      # send real email via an SMTP provider
#
#SMTP_HOST=
#SMTP_PORT=
#SMTP_USER=
#SMTP_PASS=
#EMAIL_FROM=

# --- SMS (texted code) ---
#
# Setting all the Twilio vars switches from console-printed codes to real
# texts; if any are missing the app falls back to the console transport
# and logs which ones are absent. The interactive setup script verifies
# credentials, provisions a number, and writes these values (run from the
# repo root):
#
#   ./infra/twilio/setup-twilio.mts
#
# Provide TWILIO_MESSAGING_SERVICE_SID (preferred; required for RCS) or
# TWILIO_FROM (a Twilio number in E.164).
#
# Text never arrives? Check the delivery log (carriers can filter messages
# the API accepted, e.g. 30034 = unregistered A2P 10DLC number):
#   https://console.twilio.com/us1/monitor/logs/sms
#
#TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_AUTH_TOKEN=your-auth-token
#TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_FROM=+15005550006

# --- Bot check (Cloudflare Turnstile) ---
#
# Optional. Rate limiting and the form-token check are on by default with no
# configuration; Turnstile is an extra layer. Setting BOTH vars turns it on:
# the widget renders in the sign-in forms and the server verifies the token.
#
# Get a pair from https://dash.cloudflare.com/?to=/:account/turnstile — add a
# widget and include "localhost" in its hostname list so it works in dev.
#
# Cloudflare also publishes fixed test keys, handy for seeing each path
# without touching your real widget:
#   always passes:  1x00000000000000000000AA / 1x0000000000000000000000000000000AA
#   always blocks:  2x00000000000000000000AB / 2x0000000000000000000000000000000AA
#
#TURNSTILE_SITE_KEY=
#TURNSTILE_SECRET_KEY=

# Session signing secret. A hardcoded dev-only default is used when unset.
#JWT_SECRET=
