# Session signing key — replace with a random 32+ character secret in production.
JWT_SECRET=change-me-in-production

# Magic-link signing key — replace with a random 32+ character secret in production.
JWT_MAGIC_LINK_SECRET=change-me-in-production

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Callback URL: <your-base-url>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth credentials (https://github.com/settings/developers → OAuth Apps)
# Callback URL: <your-base-url>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Shared secret used to sign the OAuth CSRF state cookie.
# Must be at least 32 characters; keep it private.
OAUTH_STATE_SECRET=change-me-in-production
