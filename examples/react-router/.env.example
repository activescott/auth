# Copy to .env — loaded automatically by `npm run dev` (dotenv in vite.config.ts).
#
# With no .env (or everything below unset), the example runs in dev mode:
# sign-in emails and SMS codes are printed to the server console instead of
# being sent.

# --- Email (magic link + code) ---
#
# Setting SMTP_HOST switches to sending real email.
# Ready-made configs — copy one instead of this file:
#
#   cp .env.example.mailpit .env   # see emails in a local Mailpit web inbox
#   cp .env.example.smtp .env      # send real email via an SMTP provider
#
#SMTP_HOST=
#SMTP_PORT=
#SMTP_USER=
#SMTP_PASS=
#EMAIL_FROM=

# --- SMS (texted code) ---
#
# Setting all the Twilio vars switches from console-printed codes to real
# texts; if any are missing the app falls back to the console transport
# and logs which ones are absent. Both paths below need the account
# credentials, which are on the Twilio console home page:
#
#TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_AUTH_TOKEN=your-auth-token

# Twilio Verify — the quick path. Create a Verify service in the Twilio
# console (Verify > Services) and set its SID below. Twilio generates,
# texts, and checks the code from senders it already registered, so there
# is no number to buy and no US A2P 10DLC registration to wait out. It
# costs about 4-6x a raw SMS ($0.05 per successful verification plus the
# channel fee). Takes precedence over the sender vars below.
#
#TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Or send raw SMS yourself, which is cheaper per message but means owning a
# number and completing A2P 10DLC registration for US traffic (days to
# weeks). Provide TWILIO_SMS_MESSAGING_SERVICE_SID (preferred; required for
# RCS) or TWILIO_SMS_FROM (a Twilio number in E.164).
#
# Text never arrives? Check the delivery log (carriers can filter messages
# the API accepted, e.g. 30034 = unregistered A2P 10DLC number):
#   https://console.twilio.com/us1/monitor/logs/sms
#
#TWILIO_SMS_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_SMS_FROM=+15005550006

# Session signing secret. A hardcoded dev-only default is used when unset.
#JWT_SECRET=
