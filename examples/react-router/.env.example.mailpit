# Ready-made config for Mailpit (https://mailpit.axllent.org) — a local SMTP
# server with a web inbox. No account, no signup:
#
#   brew install mailpit   # or: docker run -p 8025:8025 -p 1025:1025 axllent/mailpit
#   mailpit                # web inbox at http://localhost:8025
#
# Enable with:  cp .env.example.mailpit .env   (then restart `npm run dev`)
#
# Mailpit doesn't require auth, so SMTP_USER/SMTP_PASS stay unset.

SMTP_HOST=localhost
SMTP_PORT=1025
