# Config for sending real email through an SMTP provider.
#
# Enable with:  cp .env.example.smtp .env   (then fill in values below and
# restart `npm run dev`)
#
# Any SMTP provider works, for example:
#   - Gmail: host smtp.gmail.com, port 465, user = your address,
#     pass = an app password (https://myaccount.google.com/apppasswords)
#   - Amazon SES: host email-smtp.<region>.amazonaws.com, port 587,
#     SMTP credentials from the SES console
#   - Mailgun, Postmark, Resend, Fastmail, ...: see provider's SMTP settings
#
# Port 465 uses implicit TLS; 587 uses STARTTLS (auto-detected from the port).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# The From address on sign-in emails. Many providers require this to be a
# verified address/domain.
EMAIL_FROM=you@example.com
