{
  "name": "activescott-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic direct authentication, deliberately small: single-use magic links and one-time codes via email and SMS today; passkeys planned. No third-party identity providers.",
  "type": "module",
  "workspaces": [
    "packages/auth",
    "packages/auth-provider-email",
    "packages/auth-provider-sms",
    "packages/auth-sms-twilio",
    "packages/auth-adapter-react-router",
    "examples/react-router",
    "examples/react-router/tests"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "prettier --check .",
    "prepare": "husky"
  },
  "author": "Scott Willeke",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@simple-release/core": "^2.4.0",
    "@simple-release/github": "^2.4.0",
    "@simple-release/npm": "^2.3.0",
    "husky": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.1"
  }
}
