{
  "name": "activescott-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic authentication with provider pattern for magic links, OAuth, and more",
  "type": "module",
  "workspaces": [
    "packages/auth",
    "packages/auth-provider-email",
    "packages/auth-provider-oauth",
    "packages/auth-adapter-react-router",
    "examples/react-router",
    "examples/react-router/tests"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint:code && npm run lint:md",
    "lint:code": "eslint packages/*/src examples/react-router/app",
    "lint:code:fix": "eslint packages/*/src examples/react-router/app --fix",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore \"**/CHANGELOG.md\"",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --ignore \"**/CHANGELOG.md\" --fix",
    "lint:fix": "npm run lint:code:fix && npm run lint:md:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint --fix"
    ]
  },
  "author": "Scott Willeke",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@simple-release/core": "^2.4.0",
    "@simple-release/github": "^2.4.0",
    "@simple-release/npm": "^2.3.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.0.0"
  }
}
