{
  "name": "@activescott/auth-adapter-react-router",
  "version": "2.0.0",
  "description": "React Router adapter for @activescott/auth",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "auth",
    "authentication",
    "react-router",
    "remix"
  ],
  "author": "Scott Willeke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/activescott/auth.git",
    "directory": "packages/auth-adapter-react-router"
  },
  "peerDependencies": {
    "@activescott/auth": "^5.0.0",
    "react": ">=18",
    "react-router": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@activescott/auth": "*",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.3.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  }
}
